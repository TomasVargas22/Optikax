{
  "name": "optikax",
  "productName": "Optikax",
  "version": "0.1.0",
  "description": "Optimizador de PC enfocado 100% en gaming, con anÃ¡lisis por IA de tu hardware.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:tweaks": "electron-vite build && set OPTIKAX_VERIFY=1&& electron .",
    "verify:ai": "electron-vite build && set OPTIKAX_VERIFY=ai&& electron .",
    "verify:game": "electron-vite build && set OPTIKAX_VERIFY=game&& electron .",
    "capture": "electron-vite build && set OPTIKAX_CAPTURE=1&& electron .",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.optikax.app",
    "productName": "Optikax",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/main/verify-*.js",
      "!out/main/capture-*.js"
    ],
    "extraResources": [
      {
        "from": "resources/scripts",
        "to": "scripts"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
